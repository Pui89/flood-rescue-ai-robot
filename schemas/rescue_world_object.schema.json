{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flood Rescue World Object",
  "type": "object",
  "required": ["object_id", "object_class", "position_xyz_m", "confidence"],
  "properties": {
    "object_id": {"type": "string", "minLength": 1},
    "object_class": {"enum": ["person", "hazard", "vehicle", "structure", "water", "unknown"]},
    "position_xyz_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "velocity_xyz_mps": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "covariance_xyz": {"type": ["array", "null"], "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "occluded": {"type": "boolean"},
    "dynamic": {"type": "boolean"}
  }
}